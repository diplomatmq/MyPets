# Copy to backend/.env for a local NestJS run.
# Do not commit this file after inserting real secrets.

NODE_ENV=development
PORT=3000

# Get this value from @BotFather. It must stay on the backend.
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_BOT_USERNAME=CHANGE_ME_BOT_USERNAME

# Local services. For docker-compose use the service hostnames from the root .env.
DATABASE_URL=postgresql://duo_pet:CHANGE_ME_STRONG_DATABASE_PASSWORD@localhost:5432/duo_pet
REDIS_URL=redis://localhost:6379

APP_URL=https://pets.monkeysdynasty.website
CORS_ORIGIN=http://localhost:5173,https://pets.monkeysdynasty.website
