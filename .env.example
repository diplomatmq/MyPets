# Copy this file to .env and replace every CHANGE_ME value.
# Never commit .env or send TELEGRAM_BOT_TOKEN to the frontend.

# Telegram BotFather token used only by the NestJS backend to validate initData.
TELEGRAM_BOT_TOKEN=8760370452:AAHhH6ucYha8krQSs67bKKK8jsXRB3URmR8
TELEGRAM_BOT_USERNAME=MDpets_bot

# Public Telegram Mini App URL and API origin.
APP_URL=https://pets.monkeysdynasty.website
VITE_API_URL=/api

# Public reverse-proxy hostname used by Caddy for automatic HTTPS.
PUBLIC_HOST=pets.monkeysdynasty.website

# Runtime.
NODE_ENV=production
PORT=3000

# PostgreSQL credentials used by docker-compose.
POSTGRES_DB=duo_pet
POSTGRES_USER=duo_pet
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://duo_pet:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/duo_pet

# Redis used for locks, rate limits and future background jobs.
REDIS_URL=redis://redis:6379

# Allowed browser origins for the API.
CORS_ORIGIN=https://pets.monkeysdynasty.website